#!/usr/bin/env bash

# Canonical AutoDL configuration for the paper-facing mixed-probe experiment.
# Callers may override any value before launching the runner, for example:
#   DATASETS=math500_test THRESHOLDS=0.30 bash .../run_scheduler_eval_kv_fixed4.sh

export ROOT_DIR="${ROOT_DIR:-/root/LEAP}"
export CONDA_ENV="${CONDA_ENV:-care_env}"
export DATA_ROOT="${DATA_ROOT:-/root/autodl-tmp/LEAP_data}"

export TRAJ_DIR="${TRAJ_DIR:-${DATA_ROOT}/dataset/mixed_probe_trajectories-old}"
export TRAIN_LABEL_PATH="${TRAIN_LABEL_PATH:-${DATA_ROOT}/dataset/mixed_gsm8k_svamp_math500_calib_labels_balanced_5to1.pt}"
export ARTIFACT_PATH="${ARTIFACT_PATH:-${DATA_ROOT}/result/artifacts/probe_artifact_mixed_gsm8k_svamp_math500_balanced_5to1.pt}"

export SMALL_MODEL_PATH="${SMALL_MODEL_PATH:-/root/autodl-tmp/models/Qwen2.5-1.5B}"
export LARGE_MODEL_PATH_GSM8K_SVAMP="${LARGE_MODEL_PATH_GSM8K_SVAMP:-/root/autodl-tmp/models/Qwen2.5-7B}"
export LARGE_MODEL_PATH_MATH500="${LARGE_MODEL_PATH_MATH500:-/root/autodl-tmp/models/Qwen2.5-7B}"
export LARGE_MODEL_PARAMS_B_GSM8K_SVAMP="${LARGE_MODEL_PARAMS_B_GSM8K_SVAMP:-7.0}"
export LARGE_MODEL_PARAMS_B_MATH500="${LARGE_MODEL_PARAMS_B_MATH500:-7.0}"

export DATASETS="${DATASETS:-gsm8k_test svamp_test math500_test}"
export THRESHOLDS="${THRESHOLDS:-0.15,0.20,0.25,0.30,0.35,0.40,0.45,0.50}"
export RUNTIME_CHUNKING="${RUNTIME_CHUNKING:-rsdmath}"
export HANDOFF_MODE="${HANDOFF_MODE:-takeover}"
export ADAPTIVE_LARGE_HANDOFF="${ADAPTIVE_LARGE_HANDOFF:-0}"
export MAX_HANDOFFS="${MAX_HANDOFFS:-2}"
export LARGE_HANDOFF_CHUNKS="${LARGE_HANDOFF_CHUNKS:-4}"
export COOLDOWN_CHUNKS="${COOLDOWN_CHUNKS:-2}"
export PERSISTENT_KV_CACHE="${PERSISTENT_KV_CACHE:-1}"
export MATH500_MAX_NEW_TOKENS="${MATH500_MAX_NEW_TOKENS:-1024}"
export TRACE_TAG="${TRACE_TAG:-mixedprobe_kv_fixed4_full}"

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
